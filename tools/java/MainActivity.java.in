//@@push

    // ── התראות (FCM) ──
    // הדף שואל את המעטפת על האסימון (op: token), ובלחיצה על «הפעלה» — גם על ההרשאה (op: enable, אנדרואיד 13+);
    // הגשר מוגבל למקור של האפליקציה, כמו גשר השיתוף, והתשובה — { perm, token }. ההתראה עצמה — ShellPushService.
    private static final String PUSH_ORIGIN = "@@ORIGIN@@";
    private static final Set<String> PUSH_ORIGINS = new HashSet<>(Arrays.asList(PUSH_ORIGIN));
    private static final int REQ_PUSH = 7301;
    private JavaScriptReplyProxy pushReply;

    @Override
    protected void installPush() {
        if (!WebViewFeature.isFeatureSupported(WebViewFeature.WEB_MESSAGE_LISTENER)) return;
        WebViewCompat.addWebMessageListener(
            webView, "AndroidPush", PUSH_ORIGINS,
            new WebViewCompat.WebMessageListener() {
                @Override
                public void onPostMessage(@NonNull WebView view, @NonNull WebMessageCompat message,
                                          @NonNull Uri sourceOrigin, boolean isMainFrame,
                                          @NonNull JavaScriptReplyProxy replyProxy) {
                    if (!isMainFrame || !PUSH_ORIGIN.equals(String.valueOf(sourceOrigin))) return;
                    String op = "";
                    try { op = new JSONObject(String.valueOf(message.getData())).optString("op"); } catch (Exception e) { op = ""; }
                    pushReply = replyProxy;
                    // התראות שנחסמו — רק הגדרות הטלפון מבטלות חסימה: המסך של האפליקציה שם
                    if ("settings".equals(op)) { pushSettings(); pushPost(replyProxy, "", ""); return; }
                    // ההרשאה נשאלת רק מלחיצה של המשתמש — בכניסה (token) רק נבדק אם כבר ניתנה
                    if ("enable".equals(op) && Build.VERSION.SDK_INT >= 33
                            && checkSelfPermission(Manifest.permission.POST_NOTIFICATIONS) != PackageManager.PERMISSION_GRANTED) {
                        requestPermissions(new String[] { Manifest.permission.POST_NOTIFICATIONS }, REQ_PUSH);
                        return;
                    }
                    pushAnswer();
                }
            });
    }

    private void pushSettings() {
        Intent i;
        if (Build.VERSION.SDK_INT >= 26) {
            i = new Intent(android.provider.Settings.ACTION_APP_NOTIFICATION_SETTINGS)
                .putExtra(android.provider.Settings.EXTRA_APP_PACKAGE, getPackageName());
        } else {
            i = new Intent(android.provider.Settings.ACTION_APPLICATION_DETAILS_SETTINGS, Uri.parse("package:" + getPackageName()));
        }
        try { startActivity(i); } catch (Exception e) { toastUi("לא נמצאו הגדרות ההתראות"); }
    }

    private boolean pushAllowed() {
        if (Build.VERSION.SDK_INT >= 33
                && checkSelfPermission(Manifest.permission.POST_NOTIFICATIONS) != PackageManager.PERMISSION_GRANTED) return false;
        return NotificationManagerCompat.from(this).areNotificationsEnabled();
    }

    private void pushAnswer() {
        final JavaScriptReplyProxy r = pushReply;
        if (r == null) return;
        if (!pushAllowed()) { pushPost(r, "denied", ""); return; }
        FirebaseMessaging.getInstance().getToken().addOnCompleteListener(task -> {
            String t = task.isSuccessful() ? task.getResult() : null;
            pushPost(r, "granted", t == null ? "" : t);
        });
    }

    private void pushPost(final JavaScriptReplyProxy r, final String perm, final String token) {
        runOnUiThread(() -> {
            try {
                JSONObject o = new JSONObject();
                o.put("perm", perm);
                o.put("token", token);
                r.postMessage(o.toString());
            } catch (Exception e) { /* הדף ממתין עד 20 שניות, ואז ממשיך בלי אסימון */ }
        });
    }

    @Override
    public void onRequestPermissionsResult(int requestCode, String[] permissions, int[] grantResults) {
        super.onRequestPermissionsResult(requestCode, permissions, grantResults);
        if (requestCode == REQ_PUSH) pushAnswer();
    }
//@@end
//@@google

    // ── כניסה עם Google ──
    // Google חוסמת כניסה בתוך WebView — הכניסה כאן, בחלון של המערכת (Credential Manager), והדף מקבל אסימון זהות
    // ל-signInWithIdToken של Supabase. הלקוח — לקוח ה-Web של הפרויקט (הקהל של האסימון); לקוח האנדרואיד נבדק בחתימה.
    private static final String GOOGLE_ORIGIN = "@@ORIGIN@@";
    private static final Set<String> GOOGLE_ORIGINS = new HashSet<>(Arrays.asList(GOOGLE_ORIGIN));
    private static final String GOOGLE_CLIENT = "@@GOOGLE@@";

    @Override
    protected void installGoogle() {
        if (!WebViewFeature.isFeatureSupported(WebViewFeature.WEB_MESSAGE_LISTENER)) return;
        WebViewCompat.addWebMessageListener(
            webView, "AndroidGoogle", GOOGLE_ORIGINS,
            new WebViewCompat.WebMessageListener() {
                @Override
                public void onPostMessage(@NonNull WebView view, @NonNull WebMessageCompat message,
                                          @NonNull Uri sourceOrigin, boolean isMainFrame,
                                          @NonNull JavaScriptReplyProxy replyProxy) {
                    if (!isMainFrame || !GOOGLE_ORIGIN.equals(String.valueOf(sourceOrigin))) return;
                    googleSignIn(replyProxy);
                }
            });
    }

    private void googleSignIn(final JavaScriptReplyProxy r) {
        GetSignInWithGoogleOption opt = new GetSignInWithGoogleOption.Builder(GOOGLE_CLIENT).build();
        GetCredentialRequest req = new GetCredentialRequest.Builder().addCredentialOption(opt).build();
        CredentialManager.create(this).getCredentialAsync(this, req, null, ContextCompat.getMainExecutor(this),
            new CredentialManagerCallback<GetCredentialResponse, GetCredentialException>() {
                @Override
                public void onResult(GetCredentialResponse res) {
                    try {
                        GoogleIdTokenCredential c = GoogleIdTokenCredential.createFrom(res.getCredential().getData());
                        googlePost(r, c.getIdToken(), false);
                    } catch (Exception e) {
                        googlePost(r, "", false);
                    }
                }
                @Override
                public void onError(GetCredentialException e) {
                    googlePost(r, "", e instanceof GetCredentialCancellationException);
                }
            });
    }

    private void googlePost(final JavaScriptReplyProxy r, final String token, final boolean cancel) {
        runOnUiThread(() -> {
            try {
                JSONObject o = new JSONObject();
                o.put("token", token);
                o.put("cancel", cancel);
                r.postMessage(o.toString());
            } catch (Exception e) { /* הדף ממתין, ואז ממשיך בלי כניסה */ }
        });
    }
//@@end
//@@share

    // המקור היחיד שרשאי להגיע לגשר השיתוף — גשר על דף שנטען מרחוק נגיש לכל מי שמגיש את הדף.
    // נאכף פעמיים: רשימת ההיתר של הפלטפורמה ובדיקת המקור בתוך הגשר.
    // origin ולא URL — הנתיב אינו גבול האבטחה.
    private static final String APP_ORIGIN = "@@ORIGIN@@";
    private static final String APP_HOST = "@@HOST@@";
    private static final Set<String> ALLOWED_ORIGINS = new HashSet<>(Arrays.asList(APP_ORIGIN));

    private boolean legacyBridgeAttached = false;

    // ── גשר שיתוף, מוגבל למקור ──
    // addJavascriptInterface מוזרק לכל frame בכל דף בלי מושג מקור — לכן מועדף addWebMessageListener (WebView 88+), שבודק את רשימת ההיתר פר-frame.
    // במסלול הישן הממשק מחובר רק על המקור שלנו, וכל קריאה בודקת שוב את המארח החי ב-UI thread.
    @Override
    protected void installBridge() {
        if (WebViewFeature.isFeatureSupported(WebViewFeature.WEB_MESSAGE_LISTENER)) {
            WebViewCompat.addWebMessageListener(
                webView, "AndroidShareBridge", ALLOWED_ORIGINS,
                new WebViewCompat.WebMessageListener() {
                    @Override
                    public void onPostMessage(@NonNull WebView view, @NonNull WebMessageCompat message,
                                              @NonNull Uri sourceOrigin, boolean isMainFrame,
                                              @NonNull JavaScriptReplyProxy replyProxy) {
                        // הגנה כפולה: WebView כבר סינן לפי ALLOWED_ORIGINS.
                        if (!isMainFrame || !APP_ORIGIN.equals(String.valueOf(sourceOrigin))) return;
                        try {
                            JSONObject o = new JSONObject(String.valueOf(message.getData()));
                            shareFile(o.optString("data"), o.optString("mime"), o.optString("name"), o.optString("text"));
                        } catch (Exception e) {
                            toastUi("שגיאה בהכנת הקובץ לשיתוף");
                        }
                    }
                });
            // כמה קבצים בבורר אחד (דוח שחולק לכמה תמונות) — גשר משלו: הדף מזהה לפי קיומו שהמעטפת יודעת לשלוח כמה, ובמעטפת ישנה — הודעה לעדכן את האפליקציה.
            WebViewCompat.addWebMessageListener(
                webView, "AndroidShareFiles", ALLOWED_ORIGINS,
                new WebViewCompat.WebMessageListener() {
                    @Override
                    public void onPostMessage(@NonNull WebView view, @NonNull WebMessageCompat message,
                                              @NonNull Uri sourceOrigin, boolean isMainFrame,
                                              @NonNull JavaScriptReplyProxy replyProxy) {
                        if (!isMainFrame || !APP_ORIGIN.equals(String.valueOf(sourceOrigin))) return;
                        try {
                            shareFiles(new JSONObject(String.valueOf(message.getData())).getJSONArray("files"));
                        } catch (Exception e) {
                            toastUi("שגיאה בהכנת הקובץ לשיתוף");
                        }
                    }
                });
//@@print
            installPrint();
//@@end
        }
        // הממשק הישן אינו מחובר כאן — עוד לא נטען דף, וחיבור בלי תנאי הוא בדיוק מה שיש למנוע; הוא מחובר בניווט, כשהמקור ידוע.
    }

    @Override
    protected void onShellNavigation(String url) {
        if (WebViewFeature.isFeatureSupported(WebViewFeature.WEB_MESSAGE_LISTENER)) return;
        boolean ours = isAppOrigin(url);
        if (ours && !legacyBridgeAttached) {
            webView.addJavascriptInterface(new ShareBridge(), "AndroidShare");
            legacyBridgeAttached = true;
        } else if (!ours && legacyBridgeAttached) {
            webView.removeJavascriptInterface("AndroidShare");
            legacyBridgeAttached = false;
        }
    }

    // https ובדיוק המארח שלנו — גם http על אותו מארח אינו אנחנו.
    private static boolean isAppOrigin(String url) {
        if (url == null) return false;
        try {
            Uri u = Uri.parse(url);
            return "https".equals(u.getScheme()) && APP_HOST.equals(u.getHost());
        } catch (Exception e) {
            return false;
        }
    }

    // ── השיתוף עצמו ──
    // אין יעד קבוע — הבורר של המערכת בוחר; יעד קבוע היה שולח את הדוח לאפליקציה אחת בלבד.
    // הקובץ — תמונה, PDF או גיליון, והסיומת נגזרת מסוג התוכן: אפליקציה שמקבלת קובץ בסיומת שגויה אינה פותחת אותו.
    // name — שם הקובץ מהדף (גיליון התלמיד והחודש); ריק — הקידומת והשעה. תיקייה לכל שיתוף, כדי ששני קבצים באותו שם לא ידרסו.
    // text — כיתוב שהיעד מצרף לקובץ (בוואטסאפ — מתחת לתמונה); ריק — בלי כיתוב.
    private void shareFile(final String base64Data, final String mimeType, final String name, final String text) {
        try {
            final String mime = mimeOf(mimeType);
            File dir = new File(getCacheDir(), "shared");
            shareSaved(writeShared(base64Data, mime, name, dir), mime, text);
        } catch (Exception e) {
            toastUi("שגיאה בהכנת הקובץ לשיתוף");
        }
    }

    private static String mimeOf(String mimeType) {
        return (mimeType == null || mimeType.isEmpty()) ? "image/jpeg" : mimeType;
    }

    // כתיבת קובץ אחד למטמון «shared», בשם שנגזר מהדף; תיקייה לכל שיתוף, כדי ששני קבצים באותו שם לא ידרסו.
    private File writeShared(String base64Data, String mime, String name, File dir) throws Exception {
        byte[] bytes = Base64.decode(base64Data, Base64.DEFAULT);
        dir.mkdirs();
        final String ext = "application/pdf".equals(mime) ? ".pdf"
            : "image/png".equals(mime) ? ".png"
            : "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet".equals(mime) ? ".xlsx"
            : "text/csv".equals(mime) ? ".csv"
            : ".jpg";
        String base = name == null ? "" : name.replaceAll("[\\\\/:*?\"<>|\\p{Cntrl}]+", " ").trim();
        if (base.toLowerCase().endsWith(ext)) base = base.substring(0, base.length() - ext.length()).trim();
        if (base.length() > 120) base = base.substring(0, 120).trim();
        final File f;
        if (base.isEmpty()) {
            f = new File(dir, "@@FILEPREFIX@@" + System.nanoTime() + ext);
        } else {
            File sub = new File(dir, String.valueOf(System.nanoTime()));
            sub.mkdirs();
            f = new File(sub, base + ext);
        }
        FileOutputStream fos = new FileOutputStream(f);
        fos.write(bytes);
        fos.flush();
        fos.close();
        return f;
    }

    // כמה קבצים — כולם נכתבים, ובורר אחד שולח את כולם (ACTION_SEND_MULTIPLE); הסוג — המשותף לכולם, ואחרת כל סוג.
    private void shareFiles(final JSONArray files) {
        final ArrayList<Uri> uris = new ArrayList<>();
        String common = null;
        try {
            File dir = new File(getCacheDir(), "shared");
            for (int i = 0; i < files.length(); i++) {
                JSONObject o = files.getJSONObject(i);
                String mime = mimeOf(o.optString("mime"));
                common = common == null ? mime : (common.equals(mime) ? common : "*/*");
                File f = writeShared(o.optString("data"), mime, o.optString("name"), dir);
                uris.add(FileProvider.getUriForFile(MainActivity.this, getPackageName() + ".fileprovider", f));
            }
        } catch (Exception e) {
            toastUi("שגיאה בהכנת הקובץ לשיתוף");
            return;
        }
        if (uris.isEmpty()) return;
        final String type = common;
        runOnUiThread(new Runnable() {
            @Override
            public void run() {
                Intent send = new Intent(Intent.ACTION_SEND_MULTIPLE);
                send.setType(type);
                send.putParcelableArrayListExtra(Intent.EXTRA_STREAM, uris);
                // ההרשאה לקריאה עוברת לכל הקבצים דרך ClipData — EXTRA_STREAM לבדו אינו מעביר אותה לכולם
                ClipData clip = ClipData.newRawUri("", uris.get(0));
                for (int i = 1; i < uris.size(); i++) clip.addItem(new ClipData.Item(uris.get(i)));
                send.setClipData(clip);
                send.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION);
                try {
                    startActivity(Intent.createChooser(send, "@@CHOOSER@@"));
                } catch (Exception e) {
                    Toast.makeText(MainActivity.this, "שגיאה בשיתוף", Toast.LENGTH_SHORT).show();
                }
            }
        });
    }

    // קובץ שכבר נכתב במטמון «shared» — לבורר השיתוף של המערכת.
    private void shareSaved(final File f, final String mime, final String text) {
        final Uri uri;
        try {
            uri = FileProvider.getUriForFile(MainActivity.this, getPackageName() + ".fileprovider", f);
        } catch (Exception e) {
            toastUi("שגיאה בהכנת הקובץ לשיתוף");
            return;
        }
        runOnUiThread(new Runnable() {
            @Override
            public void run() {
                Intent send = new Intent(Intent.ACTION_SEND);
                send.setType(mime);
                send.putExtra(Intent.EXTRA_STREAM, uri);
                if (text != null && !text.isEmpty()) send.putExtra(Intent.EXTRA_TEXT, text);
                send.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION);

                // createChooser בלי FLAG_ACTIVITY_NEW_TASK — המשתמש בוחר יעד בכל פעם, והחזרה מביאה אותו למעטפת.
                Intent toStart = Intent.createChooser(send, "@@CHOOSER@@");
                try {
                    startActivity(toStart);
                } catch (Exception e) {
                    Toast.makeText(MainActivity.this, "שגיאה בשיתוף", Toast.LENGTH_SHORT).show();
                }
            }
        });
    }

//@@print
    // ── גשר ההדפסה ──
    // מסמך מגיע כדף HTML שלם (גופנים ותמונות מוטמעים בו), נטען ב-WebView נסתר ומודפס לקובץ PDF — טקסט וקטורי, בלי חלון הדפסה; ומשם לשיתוף.
    // ה-WebView הנסתר מוחזק בשדה עד סוף הכתיבה — בלי הפניה הוא נאסף באמצע.
    private WebView printView;

    private void installPrint() {
        WebViewCompat.addWebMessageListener(
            webView, "AndroidPrintBridge", ALLOWED_ORIGINS,
            new WebViewCompat.WebMessageListener() {
                @Override
                public void onPostMessage(@NonNull WebView view, @NonNull WebMessageCompat message,
                                          @NonNull Uri sourceOrigin, boolean isMainFrame,
                                          @NonNull JavaScriptReplyProxy replyProxy) {
                    if (!isMainFrame || !APP_ORIGIN.equals(String.valueOf(sourceOrigin))) return;
                    try {
                        JSONObject o = new JSONObject(String.valueOf(message.getData()));
                        printHtml(o.optString("html"), o.optString("name"));
                    } catch (Exception e) {
                        toastUi("שגיאה בהכנת המסמך");
                    }
                }
            });
    }

    // המסמך נכתב תוך PRINT_MAX_MS, או שנפתח חלון ההדפסה של המערכת — לעולם לא «כלום».
    private static final long PRINT_MAX_MS = 15000;

    private void printHtml(final String html, final String name) {
        runOnUiThread(new Runnable() {
            @Override
            public void run() {
                if (printView != null) { toastUi("מסמך קודם עדיין בהכנה"); return; }
                final WebView pv = new WebView(MainActivity.this);
                printView = pv;
                pv.getSettings().setJavaScriptEnabled(false);
                // מחובר לחלון, שקוף ובגודל המסך — WebView שאינו מחובר אינו מתחייב לפריסה, והכתיבה עלולה לא להסתיים.
                pv.setAlpha(0f);
                ((ViewGroup) getWindow().getDecorView()).addView(pv,
                    new ViewGroup.LayoutParams(Math.max(1, webView.getWidth()), Math.max(1, webView.getHeight())));
                pv.setWebViewClient(new WebViewClient() {
                    private boolean started = false;
                    @Override
                    public void onPageFinished(WebView v, String url) {
                        if (started) return;
                        started = true;
                        // הגופנים המוטמעים מתפענחים אחרי סוף הטעינה — השהיה קצרה לפני ההדפסה.
                        v.postDelayed(new Runnable() {
                            @Override public void run() { writePdf(pv, name); }
                        }, 500);
                    }
                });
                pv.loadDataWithBaseURL(APP_ORIGIN + "/", html, "text/html", "utf-8", null);
            }
        });
    }

    private void printDone(WebView pv) {
        try { ((ViewGroup) getWindow().getDecorView()).removeView(pv); } catch (Exception e) { /* כבר הוסר */ }
        if (printView == pv) printView = null;
    }

    private void writePdf(final WebView pv, final String name) {
        String base = name == null ? "" : name.replaceAll("[\\\\/:*?\"<>|\\p{Cntrl}]+", " ").trim();
        if (base.toLowerCase().endsWith(".pdf")) base = base.substring(0, base.length() - 4).trim();
        if (base.length() > 120) base = base.substring(0, 120).trim();
        if (base.isEmpty()) base = "@@FILEPREFIX@@" + System.currentTimeMillis();
        final String title = base;
        final PrintAttributes attrs = new PrintAttributes.Builder()
            .setMediaSize(PrintAttributes.MediaSize.ISO_A4)
            .setResolution(new PrintAttributes.Resolution("pdf", "pdf", 600, 600))
            .setMinMargins(PrintAttributes.Margins.NO_MARGINS)
            .build();
        // הכרעה אחת בלבד — הכתיבה, הכשל או שעון העצר, הראשון שמגיע.
        final boolean[] settled = { false };
        final Runnable fallback = new Runnable() {
            @Override public void run() {
                if (settled[0]) return;
                settled[0] = true;
                toastUi("הכתיבה הישירה לא הצליחה — נפתח חלון ההדפסה");
                printDialog(pv, title, attrs);
            }
        };
        pv.postDelayed(fallback, PRINT_MAX_MS);
        try {
            File sub = new File(new File(getCacheDir(), "shared"), String.valueOf(System.currentTimeMillis()));
            sub.mkdirs();
            final File f = new File(sub, title + ".pdf");
            ShellPdfWriter.write(pv.createPrintDocumentAdapter(title), attrs, f,
                new Runnable() {
                    @Override public void run() {
                        runOnUiThread(new Runnable() {
                            @Override public void run() {
                                if (settled[0]) return;
                                settled[0] = true;
                                printDone(pv);
                                shareSaved(f, "application/pdf", "");
                            }
                        });
                    }
                },
                new Runnable() {
                    @Override public void run() { runOnUiThread(fallback); }
                });
        } catch (Throwable e) {
            runOnUiThread(fallback);
        }
    }

    // נפילה-חזרה: חלון ההדפסה של המערכת, ובו «שמירה כ-PDF».
    private void printDialog(final WebView pv, final String title, final PrintAttributes attrs) {
        runOnUiThread(new Runnable() {
            @Override
            public void run() {
                try {
                    PrintManager pm = (PrintManager) getSystemService(PRINT_SERVICE);
                    pm.print(title, pv.createPrintDocumentAdapter(title), attrs);
                } catch (Throwable e) {
                    toastUi("שגיאה בהכנת המסמך: " + e.getClass().getSimpleName());
                }
                printDone(pv);
            }
        });
    }
//@@end

    // מתודות JavascriptInterface רצות ב-binder thread פרטי — לכן ה-URL החי נקרא ב-UI thread לפני כל פעולה: זה המנעול השני.
    private class ShareBridge {
        @JavascriptInterface
        public void shareFile(final String base64Data, final String mimeType) {
            runOnUiThread(new Runnable() {
                @Override public void run() {
                    if (!isAppOrigin(webView.getUrl())) return;
                    MainActivity.this.shareFile(base64Data, mimeType, "", "");
                }
            });
        }
//@@print

        @JavascriptInterface
        public void printHtml(final String html, final String name) {
            runOnUiThread(new Runnable() {
                @Override public void run() {
                    if (!isAppOrigin(webView.getUrl())) return;
                    MainActivity.this.printHtml(html, name);
                }
            });
        }
//@@end
    }
//@@end
}
